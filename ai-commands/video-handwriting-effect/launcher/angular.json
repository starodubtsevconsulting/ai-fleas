{
  "$schema": "../../../../ai-launcher/node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "video-handwriting-effect-ui": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "vhe",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "styles": [
              "src/styles.css"
            ],
            "assets": []
          },
          "configurations": {
            "production": {
              "outputPath": "dist/ui",
              "optimization": true,
              "sourceMap": false,
              "extractLicenses": true,
              "baseHref": "./"
            },
            "development": {
              "outputPath": "dist/ui",
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "baseHref": "./"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "video-handwriting-effect-ui:build:production"
            },
            "development": {
              "buildTarget": "video-handwriting-effect-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
