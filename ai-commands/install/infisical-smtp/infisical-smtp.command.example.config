# Fictional, non-secret values. Bind only in an approved private profile.
VERSION=1
COMMAND=infisical-smtp
SSH_TARGET=example-host
REMOTE_ROOT=/opt/example-secrets
COMPOSE_FILE=/opt/example-secrets/compose.yml
SMTP_ENV_FILE=/opt/example-secrets/smtp.env
PROJECT_NAME=example-secrets
BACKEND_SERVICE=backend
EXPECTED_SMTP_HOST=smtp.example.invalid
EXPECTED_SMTP_PORT=587
EXPECTED_SMTP_USERNAME=example
EXPECTED_SMTP_FROM_ADDRESS=secrets@example.invalid
