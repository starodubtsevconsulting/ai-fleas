# TEMPLATE ONLY: copy into the selected AI Profile; never populate this file in ai-commands.
# COMMITTED EXAMPLE ONLY: keep this file safe, fictional, and free of credentials.
# Copy it into the selected profile and reference the copied file through commands[].config.
# The activated host exposes that profile-owned copy as AI_COMMAND_CONFIG_PATH.
# Never use this catalog example as operational configuration.
# Never commit private keys or passwords. Reference SSH key paths instead.

# Optional defaults used when a box does not override them.
defaults:
  ssh_port: 22
  preset: qwen3-coder-next
  provider_port: 8080
  storage_volume: /srv/model-storage

# A profile can describe all dedicated AI boxes available to this user/profile.
boxes:
  mini-01:
    host: 192.0.2.41
    user: ai
    ssh_key: ~/.ssh/ai-mini-01

  mini-02:
    host: 192.0.2.42
    user: ai
    ssh_key: ~/.ssh/ai-mini-02
    preset: qwen3-coder-next

  # A box may instead delegate host, user, port and identity selection to
  # the user's private ~/.ssh/config. Do not combine an alias with
  # conflicting explicit connection fields.
  lab-box:
    ssh_alias: ai-lab-box
    preset: qwen3-coder-next
    model_modes:
      coding:
        manager: user
        service: qwen-coding.service
        health_url: http://127.0.0.1:8080/v1/models
        health_timeout_seconds: 180
        verification:
          generation_url: http://127.0.0.1:8080/v1/chat/completions
          generation_timeout_seconds: 180
          generation_request:
            model: qwen-coder
            messages:
              - role: user
                content: Reply with exactly READY.
          generation_response_json_path: choices.0.message.content
      flux-image:
        manager: user
        service: flux-image-generator.service
        health_url: http://127.0.0.1:8000/health
        health_timeout_seconds: 900
      illustrious-image:
        manager: user
        service: illustrious-image-generator.service
        health_url: http://127.0.0.1:8000/health
        health_timeout_seconds: 300
      qwen-image:
        manager: user
        service: qwen-image-generator.service
        health_url: http://127.0.0.1:8000/health
        health_timeout_seconds: 900
        verification:
          public_url: https://images.example.invalid/health
          public_expected_statuses: [200, 302]
          generation_url: http://127.0.0.1:8000/v1/images/generations
          generation_timeout_seconds: 900
          generation_request:
            model: Qwen/Qwen-Image
            prompt: A plain red circle centered on a white background.
            size: 256x256
            steps: 1
            seed: 104729
            response_format: b64_json
          generation_response_json_path: data.0.b64_json
    # Optional gated-model authentication target. The token is injected by connect/secrets.
    model_auth_cache_dir: /srv/model-storage/huggingface-cache
    model_auth_image: example/image-runtime:reviewed-tag

# Add more boxes as needed.
# gx10-01:
#   host: 192.0.2.43
#   user: ai
#   ssh_key: ~/.ssh/gx10-01
#   ssh_port: 22
#   preset: qwen3-coder-next

# Password fields and password overrides are intentionally unsupported.
# Authorize a public key interactively once, then use key/agent authentication.
