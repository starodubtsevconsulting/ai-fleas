VERSION=1
COMMAND=infisical
SSH_TARGET="example-server"
REMOTE_ROOT="/opt/example-secret-service"
PROJECT_NAME="example-secret-service"
SITE_URL="https://secrets.example.invalid"
ACCESS_MODE="cloudflare"
BACKEND_PORT=8080
PROXY_PORT=8443
BACKEND_IMAGE="infisical/infisical@sha256:REPLACE_WITH_APPROVED_DIGEST"
POSTGRES_IMAGE="postgres:16-alpine@sha256:REPLACE_WITH_APPROVED_DIGEST"
REDIS_IMAGE="redis@sha256:REPLACE_WITH_APPROVED_DIGEST"
PROXY_IMAGE="nginx:alpine@sha256:REPLACE_WITH_APPROVED_DIGEST"
CLOUDFLARED_IMAGE="cloudflare/cloudflared@sha256:REPLACE_WITH_APPROVED_DIGEST"
ORIGIN_SERVER_NAME="origin.example.invalid"
ORIGIN_CERT_FILE="/opt/example-secret-service-inputs/origin.pem"
ORIGIN_KEY_FILE="/opt/example-secret-service-inputs/origin.key"
ORIGIN_CA_FILE="/opt/example-secret-service-inputs/origin-ca.pem"
CLOUDFLARED_TOKEN_FILE="/opt/example-secret-service-inputs/tunnel-token"
MINIMUM_CPUS=2
MINIMUM_MEMORY_GIB=4
MINIMUM_FREE_DISK_GIB=20
HEALTH_TIMEOUT_SECONDS=120
SSH_TIMEOUT_SECONDS=900
SMTP_ENV_FILE=""
