# Whisper install/config toggles
# 1 = enabled, 0 = disabled

WHISPER_FEATURE_INSTALL_EDGE_TTS=1
WHISPER_FEATURE_INSTALL_ESPEAK_NG=1
WHISPER_FEATURE_INSTALL_PLAYER=1
WHISPER_FEATURE_AUTORUN_SMOKE_TEST=1

# Runtime defaults for helper scripts
WHISPER_FEATURE_REQUIRE_NEURAL=1
WHISPER_FEATURE_AUTOPLAY=1
WHISPER_FEATURE_MULTI_VOICE=1

# Neural TTS defaults
WHISPER_TTS_VOICE_DEFAULT='en-US-AriaNeural'
WHISPER_TTS_RATE_DEFAULT='+0%'
WHISPER_TTS_PITCH_DEFAULT='+0Hz'

# Optional per-speaker overrides (script format)
WHISPER_TTS_VOICE_NARRATOR='en-GB-RyanNeural'
WHISPER_TTS_VOICE_MARIA='en-US-JennyNeural'
WHISPER_TTS_VOICE_ROBERT='en-US-ChristopherNeural'
WHISPER_TTS_RATE_NARRATOR='-12%'
WHISPER_TTS_RATE_MARIA='+2%'
WHISPER_TTS_RATE_ROBERT='-2%'
WHISPER_TTS_PITCH_NARRATOR='-2Hz'
WHISPER_TTS_PITCH_MARIA='+1Hz'
WHISPER_TTS_PITCH_ROBERT='-1Hz'
WHISPER_TTS_TIMEOUT_SEC=90
WHISPER_TTS_DEFAULT_UNLABELED_SPEAKER='narrator'
