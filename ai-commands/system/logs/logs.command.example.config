name: logs
command: logs.command.sh
description: Inspect service logs on remote servers via SSH and journalctl
category: system
ai:
  powered: false
  roles:
    - devops
intent:
  - "show me logs"
  - "check logs"
  - "inspect logs"
  - "monitor logs"
  - "view recent errors"
  - "what happened today"
config:
  - name: default_since
    type: string
    default: 1h
    description: Default time range for log queries
  - name: ssh_user
    type: string
    default: sergii
    description: SSH user for remote connections
requirements:
  - ssh
  - journalctl (remote)
  - grep
