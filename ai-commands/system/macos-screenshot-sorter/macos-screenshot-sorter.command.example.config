# TEMPLATE ONLY: copy into the selected AI Profile; never populate this file in ai-commands.
# COMMITTED EXAMPLE ONLY: keep this file safe, fictional, and free of credentials.
# Copy it into the selected profile and reference the copied file through commands[].config.
# The activated host exposes that profile-owned copy as AI_COMMAND_CONFIG_PATH.
# Never use this catalog example as operational configuration.

SCREENSHOT_SORTER_SOURCE_DIR="$HOME/Screenshots"
SCREENSHOT_SORTER_DESTINATION_DIR="$HOME/Screenshots"
SCREENSHOT_SORTER_LABEL="org.example.ai-fleas.macos-screenshot-sorter"
# These locations and executable are explicit profile settings, not implicit
# command defaults. Keep the LaunchAgent label stable after installation.
SCREENSHOT_SORTER_LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
SCREENSHOT_SORTER_LOG_DIR="$HOME/Library/Logs/AI Fleas"
SCREENSHOT_SORTER_PYTHON="/usr/bin/python3"
# Point to the managed Electron runtime used to open the optional settings UI.
# SCREENSHOT_SORTER_ELECTRON_BIN is optional in dev mode; launcher uses its local Electron runtime.
# After a recognized screenshot appears, wait for it to finish writing before
# moving it. 0 moves immediately; choose a whole number from 0–60.
SCREENSHOT_SORTER_SETTLE_SECONDS=2
# A missed-event safety net. It does not delay normal WatchPaths sorting.
# Set 0 to disable it, or choose a whole number from 10–3600.
SCREENSHOT_SORTER_START_INTERVAL_SECONDS=10
# Needed only for isolated candidate acceptance. Suspending the legacy label
# leaves its script and plist intact; restore it if candidate acceptance fails.
SCREENSHOT_SORTER_LEGACY_LABEL="org.example.legacy-screenshot-sorter"
SCREENSHOT_SORTER_LEGACY_PLIST="$HOME/Library/LaunchAgents/org.example.legacy-screenshot-sorter.plist"
# Filename pattern: regex to identify screenshot files. Default: ^(?:Screenshot|Screen Shot)(?:[ _-]|$)
# SCREENSHOT_SORTER_PATTERN="^(?:Screenshot|Screen Shot)(?:[ _-]|$)"
# Date pattern in filename: captures YYYY-MM-DD for folder organization. Default: ^(?:Screenshot|Screen Shot)[ _-]+(\d{4}-\d{2}-\d{2})(?:[ _-]|$)
# SCREENSHOT_SORTER_DATE_PATTERN="^(?:Screenshot|Screen Shot)[ _-]+(\d{4}-\d{2}-\d{2})(?:[ _-]|$)"
