# TEMPLATE ONLY: copy into the selected AI Profile; never populate this file in ai-commands.
# COMMITTED EXAMPLE ONLY: keep this file safe, fictional, and free of credentials.
# Copy it into the selected profile and reference the copied file through commands[].config.
# The activated host exposes that profile-owned copy as AI_COMMAND_CONFIG_PATH.
# Never use this catalog example as operational configuration.

# Replace these fictional values only in the profile-owned copy.
# Never store token values in this file. Export the referenced environment variables from a secret store.

# Optional multi-server mode. Each safe relative file contains the flat target variables shown below.
# CLOUDFLARE_SERVER_TARGETS="server-one=cloudflare/server-one.env,server-two=cloudflare/server-two.env"
# Set CLOUDFLARE_SERVER_ID to one listed server when invoking a target operation.
# The always-on controller starts all targets by default. Before installing it, optionally export:
# CLOUDFLARE_UI_AUTOSTART="server-one,server-two"
# On an Ubuntu gateway, each target origin may be a different private-network service host.
# Its GNOME controller writes only per-server desired state under the systemd-managed state directory;
# tunnel tokens remain profile-owned.

CLOUDFLARE_PUBLIC_URL="https://ai.example.invalid"
CLOUDFLARE_ORIGIN_URL="http://192.0.2.10:8000"
# Use "container" only when the connector and a single-label Compose service name
# share a private container network. Host scope is the default.
CLOUDFLARE_ORIGIN_SCOPE="host"
# For an HTTPS origin whose certificate hostname differs from the private service URL,
# set CLOUDFLARE_ORIGIN_SERVER_NAME to that certificate hostname. Leave both fields
# empty for an HTTP origin or an HTTPS origin trusted through the system CA pool.
# CLOUDFLARE_ORIGIN_SERVER_NAME="ai.example.invalid"
# CLOUDFLARE_ORIGIN_CA_POOL="/absolute/profile-owned/path/to/origin-ca.pem"
CLOUDFLARE_TUNNEL_NAME="example-private-ai"
CLOUDFLARE_TUNNEL_TOKEN_ENV="EXAMPLE_CLOUDFLARE_TUNNEL_TOKEN"
CLOUDFLARE_TUNNEL_TOKEN_FILE=""
CLOUDFLARE_API_TOKEN_ENV="EXAMPLE_CLOUDFLARE_API_TOKEN"
CLOUDFLARE_ACCOUNT_ID="0123456789abcdef0123456789abcdef"
CLOUDFLARE_ZONE_ID="abcdef0123456789abcdef0123456789"
CLOUDFLARE_ALLOWED_EMAILS="trusted.user@example.invalid"
CLOUDFLARE_ACCESS_LOGIN_SUFFIX=".cloudflareaccess.com"
