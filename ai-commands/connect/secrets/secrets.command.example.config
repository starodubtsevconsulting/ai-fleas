# TEMPLATE ONLY: copy into the selected AI Profile; never populate this file in ai-commands.
# COMMITTED EXAMPLE ONLY: fictional configuration and credential references.
# Bind a profile-owned copy through commands[].config, exposed as AI_COMMAND_CONFIG_PATH.
# Example profile-owned configuration for the provider-neutral `secrets` capability.
#
# This file intentionally contains fictional/non-routable values and secret references only.
# Real profile names, infrastructure names, domains, machine identities, mappings, and
# credential values belong in the user's private profile/configuration surface.
provider: infisical
endpoint: https://secrets.example.invalid

# Provider-specific runtime details are selected here, while workflows and other
# commands depend only on the portable `secrets` capability.
provider_config:
  project: example-project
  environment: example
  machine_identity: example-runtime
  universal_auth:
    # Bootstrap values are direct environment-variable references, never secret
    # lookups. Resolving a provider credential through this adapter would recurse.
    client_id:
      source: environment
      variable: EXAMPLE_INFISICAL_CLIENT_ID
    client_secret:
      source: environment
      variable: EXAMPLE_INFISICAL_CLIENT_SECRET

# Logical names are stable profile-facing references. Values are resolved by the
# configured backend at execution time and must never be committed here.
secrets:
  example.api_token:
    ref: ${secret:example.api_token}
    backend:
      path: /example/integrations
      key: api_token
  example.service_password:
    ref: ${secret:example.service_password}
    backend:
      path: /example/services
      key: password

# Consumers receive only the variables they declare, in the child process that
# runs the command. The parent agent, prompts, reports, and durable memory do
# not receive resolved values.
command_injection:
  example-command:
    environment:
      EXAMPLE_API_TOKEN:
        logical_secret: example.api_token
  example-service-client:
    environment:
      EXAMPLE_SERVICE_PASSWORD:
        logical_secret: example.service_password

policy:
  inject_at_execution_time: true
  delivery_scope: child-process-only
  persist_values_in_git: false
  persist_values_in_memory: false
  log_values: false
