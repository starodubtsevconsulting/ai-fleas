# Fictional unattended Trello binding. Copy into an authorized private profile.
# Keep credentials in the secrets provider, not this file.
version: 1
command: ticket-tracker
workflows:
  dev.workflow.md:
    provider: trello
    capability: trello
    workspace: example-workspace
    container:
      name: Example Board
      id: 000000000000000000000001
      url: https://trello.example.invalid/b/example-board
    lifecycle:
      backlog: Backlog
      in_progress: In Progress
      done: Done
    lists:
      backlog: 000000000000000000000002
      in_progress: 000000000000000000000003
      done: 000000000000000000000004
    disabled_providers: []
    supported_operations:
      - read
      - status_inventory
    execution:
      transport: api
      registered_command: trello
      command_path: trello/trello.command.sh
      command_env_overrides: {}
