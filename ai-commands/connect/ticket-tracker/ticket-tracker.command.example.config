version: 1
command: ticket-tracker
workflows:
  example.workflow.md:
    provider: trello
    capability: trello
    workspace: REPLACE_WITH_AUTHORIZED_WORKSPACE_ID
    container:
      id: REPLACE_WITH_AUTHORIZED_BOARD_ID
      url: https://trello.example.invalid/b/example-board
    lifecycle:
      backlog: Backlog
      in_progress: In Progress
      done: Done
    lists:
      backlog: REPLACE_WITH_AUTHORIZED_BACKLOG_LIST_ID
      in_progress: REPLACE_WITH_AUTHORIZED_IN_PROGRESS_LIST_ID
      done: REPLACE_WITH_AUTHORIZED_DONE_LIST_ID
    disabled_providers: [jira]
    supported_operations: [search, read, status_inventory, board_inventory, list_inventory]
    execution:
      registered_command: trello
      command_path: trello/trello.command.md
      command_env_overrides: {}
