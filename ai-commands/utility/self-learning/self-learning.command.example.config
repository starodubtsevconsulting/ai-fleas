# self-learning command configuration template
# Copy to your profile's commands-config/self-learning/ and set operational values

# Knowledge extraction settings
knowledge:
  # Where to store extracted knowledge
  storage_root: ./ai-commands/utility/self-learning/knowledge
  # File naming pattern
  file_pattern: "{scope}-knowledge.md"
  # Max age of knowledge entries before review
  review_age_days: 30

# Learning scope mappings
scopes:
  financial-insights:
    learnings_file: ../../ai-workflows/financial-insights/AGENTS.md
    related_files:
      - ../../ai-profile/sc/AGENTS.md
      - ../../AGENTS.md
  hermes-agents:
    learnings_file: ../../ai-commands/system/hermes-agents/AGENTS.md
    related_files:
      - ../../AGENTS.md

# Validation settings
validation:
  # Check for duplicate knowledge entries
  duplicate_check: true
  # Require evidence for each learning
  require_evidence: true
  # Maximum knowledge entries per file
  max_entries: 50
