# Shell-sourced defaults for `sms.command.sh`.
# Copy to `sms.command.config` for local overrides (gitignored by *.config).

#########

# Default provider. Supported: "twilio", "console"
SMS_PROVIDER="twilio"

# Optional: hardcode a default recipient number (e.g. +155542422222).
# If empty, `sms.command.sh` will try to read `user-phone-number:` from the
# local SMS configuration file.
SMS_DEFAULT_TO=""

# Twilio settings (true SMS).
# Prefer env vars for secrets. You can keep non-secret identifiers here.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

#########

# Optional recipient config path (used to derive `user-phone-number`).
# If empty, `sms.command.sh` uses this local SMS configuration file.
SMS_RECIPIENT_CONFIG_PATH=""


# Optional alternative to TWILIO_FROM_NUMBER:
# If set, messages will be sent using this Messaging Service (MessagingServiceSid).
TWILIO_MESSAGING_SERVICE_SID=""
