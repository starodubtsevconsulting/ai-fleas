# Shell-sourced defaults for `pomodoro.command.sh`.
# Copy to `pomodoro.command.config` for local overrides (gitignored by *.config).

# If empty, uses built-in defaults or session preset if provided.
POMODORO_POLICY_DEFAULT_PATH=""

# Optional local override config path.
POMODORO_SESSION_CONFIG_PATH=""

# Plan file to append results to. If empty, defaults to the active session `<session-root>/<work-profile>/<session-id>/session-plan.md`.
POMODORO_PLAN_FILE=""

# State file to persist current pomodoro state to. If empty, defaults to `${project_dir}/session-root/pomodoro.state.json`.
POMODORO_STATE_FILE=""

# PID file for background timer. If empty, defaults to `${project_dir}/session-root/pomodoro.pid`.
POMODORO_PID_FILE=""

# History file (append-only). If empty, defaults to `${project_dir}/session-root/pomodoro.history.ndjson`.
POMODORO_HISTORY_FILE=""

# SMS behavior: 1=on, 0=off
POMODORO_SMS_ENABLED=1

# Template strings (bash): available vars at send time:
# - TASK, WORK_MIN, BREAK_MIN
POMODORO_SMS_WORK_START_TEMPLATE="Pomodoro started: \${TASK} (\${WORK_MIN}m)."
POMODORO_SMS_WORK_DONE_TEMPLATE="Pomodoro done: \${TASK}. Break: \${BREAK_MIN}m."
POMODORO_SMS_BREAK_DONE_TEMPLATE="Break done: \${TASK}. Ready for next pomodoro?"
