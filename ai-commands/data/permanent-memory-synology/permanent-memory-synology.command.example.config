# Public example only. Keep concrete host/user/path/key values in profile-owned private config.
HOST=nas.example.invalid
USER=ai-memory
PORT=22
ROOT=/volume1/permanent-memory
ACCESS=read-only
IDENTITY_FILE=~/.ssh/ai-memory
TRANSPORT=tailscale

# Semantic mapping inside ROOT. Existing Obsidian vaults may use different names.
INBOX_DIR=Inbox
REFERENCES_DIR=References
CONCEPTS_DIR=Concepts
OUTPUTS_DIR=Articles
