# TEMPLATE ONLY: copy into the selected AI Profile; never populate this file in ai-commands.
# COMMITTED EXAMPLE ONLY: keep this file safe, fictional, and free of credentials.
# Copy it into the selected profile and reference the copied file through commands[].config.
# The activated host exposes that profile-owned copy as AI_COMMAND_CONFIG_PATH.
# Never use this catalog example as operational configuration.

# Copy this file into a private profile and replace only the example values.
# Evaluators are reusable profile resources. Workflow bindings explicitly opt a
# workflow into one evaluator and one policy profile; unlisted workflows inherit
# nothing from another workflow.
machine_label: local-benchmark-host
output_root: /data/image-benchmarks/runs
python: /opt/image-benchmark/bin/python

policy_evaluators:
  local-multimodal:
    host_ref: example-policy-host
    transport: http-json-v1
    endpoint: http://policy-evaluator.internal.example/v1/decide
    model: example-vision-policy-model
    timeout_seconds: 120
    client_token_file: /run/policy-tokens/moderation.token
    service: ai-policy-evaluator.service
    runtime:
      num_gpu_layers: 0
      keep_alive: -1

workflow_policy_bindings:
  example.workflow.md:
    capability: image
    generator:
      host_ref: example-image-host
      mode: image-generation
    policy_profile: example-restricted
    evaluator: local-multimodal
    semantic_input: true
    semantic_output: true

# Never put tokens, passwords, private URLs, hostnames, account names, or
# personal filesystem paths in the public template or committed result files.
