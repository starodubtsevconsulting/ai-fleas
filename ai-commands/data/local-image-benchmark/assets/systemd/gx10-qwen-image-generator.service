[Unit]
Description=GX10 Qwen-Image generator
After=docker.service network-online.target
Wants=network-online.target
Conflicts=qwen3-coder-next.service gx10-image-generator.service gx10-anime-generator.service

[Service]
Type=simple
EnvironmentFile=%h/.config/ai-fleas/qwen-image-generator.env
ExecStartPre=-/usr/bin/docker rm -f gx10-qwen-image-generator
ExecStart=/usr/bin/docker run --rm --name gx10-qwen-image-generator --gpus=all --network=host --ipc=host -e IMAGE_MODEL_ID -e IMAGE_MODEL_REVISION -e IMAGE_DTYPE -e IMAGE_DEFAULT_STEPS -e IMAGE_DEFAULT_GUIDANCE -e IMAGE_GUIDANCE_PARAMETER -e IMAGE_DEFAULT_NEGATIVE_PROMPT -e IMAGE_PORT=8000 -v %h/image-benchmarks/harness:/benchmark:ro -v %h/.cache/huggingface:/root/.cache/huggingface -v %h/image-benchmarks/outputs:/outputs --entrypoint python3 ai-fleas/gx10-image-benchmark:26.08 /benchmark/serve.py
ExecStop=-/usr/bin/docker stop -t 30 gx10-qwen-image-generator
Restart=no
TimeoutStopSec=45

[Install]
WantedBy=default.target
