[Unit]
Description=GX10 Qwen-Image generator
After=docker.service network-online.target
Wants=network-online.target
Conflicts=qwen3-coder-next.service gx10-image-generator.service gx10-anime-generator.service

[Service]
Type=simple
EnvironmentFile=%h/.config/ai-fleas/qwen-image-generator.env
ExecStartPre=-/usr/bin/docker rm -f gx10-qwen-image-generator
ExecStart=/usr/bin/docker run --rm --name gx10-qwen-image-generator --gpus=all --network=host --ipc=host -e IMAGE_MODEL_ID -e IMAGE_MODEL_REVISION -e IMAGE_DTYPE -e IMAGE_DEFAULT_STEPS -e IMAGE_DEFAULT_GUIDANCE -e IMAGE_GUIDANCE_PARAMETER -e IMAGE_DEFAULT_NEGATIVE_PROMPT -e IMAGE_DEFAULT_SIZE -e IMAGE_MAX_WIDTH -e IMAGE_MAX_HEIGHT -e IMAGE_MAX_PIXELS -e IMAGE_MAX_STEPS -e IMAGE_MIN_AVAILABLE_BYTES -e IMAGE_EMERGENCY_AVAILABLE_BYTES -e IMAGE_MEMORY_POLL_SECONDS -e IMAGE_EXIT_ON_MEMORY_EMERGENCY -e IMAGE_RELEASE_CACHE_AFTER_GENERATION -e IMAGE_POLICY_PRESET -e IMAGE_POLICY_SEMANTIC_INPUT -e IMAGE_POLICY_SEMANTIC_OUTPUT -e IMAGE_POLICY_MODERATION_URL -e IMAGE_POLICY_MODERATION_TIMEOUT_SECONDS -e IMAGE_POLICY_MODERATION_AUTH_TOKEN_FILE -e IMAGE_PORT=8000 -v %h/image-benchmarks/harness:/benchmark:ro -v %h/.cache/huggingface:/root/.cache/huggingface -v %h/generated-images/qwen-image:/outputs --entrypoint python3 ai-fleas/gx10-image-benchmark:26.08 /benchmark/serve.py
ExecStop=-/usr/bin/docker stop -t 30 gx10-qwen-image-generator
Restart=on-failure
RestartSec=30
TimeoutStopSec=45

[Install]
WantedBy=default.target
