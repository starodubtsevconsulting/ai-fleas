[Unit]
Description=Local image generator (%i)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=IMAGE_GENERATOR_INSTANCE=%i
EnvironmentFile=%h/.config/ai-fleas/image-generators/%i.env
ExecStartPre=-/usr/bin/docker rm -f ai-image-generator-%i
ExecStart=%h/.local/lib/ai-fleas/run-image-generator-container.sh
ExecStop=-/usr/bin/docker stop -t 30 ai-image-generator-%i
Restart=on-failure
RestartSec=30
TimeoutStopSec=45

[Install]
WantedBy=default.target
