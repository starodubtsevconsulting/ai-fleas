# Optional model preset. Merge these values into a profile-owned generator instance.
IMAGE_MODEL_ID=Qwen/Qwen-Image
IMAGE_MODEL_REVISION=75e0b4be04f60ec59a75f475837eced720f823b6
IMAGE_DTYPE=bfloat16
IMAGE_DEFAULT_STEPS=50
IMAGE_DEFAULT_GUIDANCE=4.0
IMAGE_GUIDANCE_PARAMETER=true_cfg_scale
IMAGE_DEFAULT_NEGATIVE_PROMPT=" "
IMAGE_DEFAULT_SIZE=1344x768
IMAGE_MAX_WIDTH=1344
IMAGE_MAX_HEIGHT=1344
IMAGE_MAX_PIXELS=1048576
IMAGE_MAX_STEPS=50
IMAGE_MIN_AVAILABLE_BYTES=21474836480
IMAGE_EMERGENCY_AVAILABLE_BYTES=8589934592
IMAGE_MEMORY_POLL_SECONDS=0.5
IMAGE_EXIT_ON_MEMORY_EMERGENCY=true
IMAGE_RELEASE_CACHE_AFTER_GENERATION=true
IMAGE_POLICY_PRESET=unrestricted
IMAGE_POLICY_SEMANTIC_INPUT=false
IMAGE_POLICY_SEMANTIC_OUTPUT=false
IMAGE_POLICY_MODERATION_URL=
IMAGE_POLICY_MODERATION_TIMEOUT_SECONDS=5
IMAGE_POLICY_MODERATION_AUTH_TOKEN_FILE=/run/policy-tokens/moderation.token
