IMAGE_RUNTIME_IMAGE=example/image-generator-runtime:version
IMAGE_ACCELERATOR=nvidia
IMAGE_NETWORK_MODE=host
IMAGE_HARNESS_DIR=/opt/image-generator/harness
IMAGE_OUTPUT_DIR=/data/generated-images/example
IMAGE_MODELS_DIR=/data/image-models
IMAGE_CACHE_DIR=/data/model-cache
IMAGE_POLICY_TOKEN_DIR=/run/private-policy-tokens
IMAGE_MODEL_ID=example/image-model
IMAGE_DTYPE=bfloat16
IMAGE_DEFAULT_STEPS=50
IMAGE_DEFAULT_GUIDANCE=4.0
IMAGE_PORT=8000
IMAGE_POLICY_PRESET=unrestricted
IMAGE_POLICY_SEMANTIC_INPUT=false
IMAGE_POLICY_SEMANTIC_OUTPUT=false
IMAGE_POLICY_MODERATION_URL=
IMAGE_POLICY_MODERATION_TIMEOUT_SECONDS=5
IMAGE_POLICY_MODERATION_AUTH_TOKEN_FILE=/run/policy-tokens/moderation.token
