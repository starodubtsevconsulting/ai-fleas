{
  "description": "Universal lifecycle enforcement for receipt-bound AI Fleas workflow endpoints.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/workflow-router-hook.mjs",
            "timeout": 10,
            "statusMessage": "Loading Workflow Router binding",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/workflow-router-hook.mjs",
            "timeout": 10,
            "statusMessage": "Resolving workflow ingress",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/workflow-router-hook.mjs",
            "timeout": 10,
            "statusMessage": "Validating Workflow Router result"
          }
        ]
      }
    ]
  }
}
