{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-fleas/context-capacity/evidence.schema.json",
  "title": "Context Capacity run evidence",
  "description": "Schema for one sanitized run record. A record is evidence, not a model capability claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "run_id", "fixture_id", "packet_layout", "phase", "arm", "sequence_position",
    "artifact_hashes", "expected_identity", "observed_identity", "context",
    "process", "retention", "verification", "completion", "scope", "telemetry", "restoration",
    "first_pass_accepted", "valid_run"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "experiment_id": { "const": "qwen3-coder-next-q5km-context-capacity" },
    "run_id": { "type": "string", "minLength": 1 },
    "fixture_id": { "const": "hermes-context-capacity-integration" },
    "packet_layout": { "const": "fixed-distributed-205080" },
    "phase": { "enum": ["exploratory", "confirmation"] },
    "arm": { "enum": ["A", "B", "C"] },
    "sequence_position": { "type": "integer", "minimum": 1 },
    "artifact_hashes": { "$ref": "#/$defs/hashMap" },
    "expected_identity": { "$ref": "#/$defs/identity" },
    "observed_identity": { "$ref": "#/$defs/identity" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_server_tokens", "observed_server_tokens", "configured_hermes_tokens",
        "observed_hermes_tokens", "cumulative_delivered_tokens", "largest_model_input_tokens",
        "final_model_input_tokens", "headroom_tokens", "observed_effective_context_tokens",
        "compression_enabled", "compression_trigger_tokens", "compaction_count", "compaction_time_ms",
        "eviction_evidence", "zone_offsets", "rendered_packet_sha256", "chunk_count",
        "chunks_verified", "tokenizer_id", "tokenizer_version", "unexpected_truncation_detected"
      ],
      "properties": {
        "configured_server_tokens": { "enum": [65536, 131072, 262144] },
        "observed_server_tokens": { "enum": [65536, 131072, 262144] },
        "configured_hermes_tokens": { "enum": [65536, 131072, 262144] },
        "observed_hermes_tokens": { "enum": [65536, 131072, 262144] },
        "cumulative_delivered_tokens": { "const": 205080 },
        "largest_model_input_tokens": { "type": "integer", "minimum": 1 },
        "final_model_input_tokens": { "type": "integer", "minimum": 1 },
        "headroom_tokens": { "const": 8192 },
        "observed_effective_context_tokens": { "type": "integer", "minimum": 1 },
        "compression_enabled": { "type": "boolean" },
        "compression_trigger_tokens": { "type": "integer", "minimum": 1 },
        "compaction_count": { "type": "integer", "minimum": 0 },
        "compaction_time_ms": { "type": ["number", "null"], "minimum": 0 },
        "eviction_evidence": { "type": ["string", "null"] },
        "zone_offsets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["EARLY", "MIDDLE", "LATE", "TASK"],
          "properties": {
            "EARLY": { "const": 20000 },
            "MIDDLE": { "const": 90000 },
            "LATE": { "const": 150000 },
            "TASK": { "const": 205000 }
          }
        },
        "rendered_packet_sha256": { "const": "fa8aaef878e42c88a556b8642052427eed01cec0625d0fb1ffe0e180efc128bb" },
        "chunk_count": { "const": 53 },
        "chunks_verified": { "const": true },
        "tokenizer_id": { "type": "string", "minLength": 1 },
        "tokenizer_version": { "type": "string", "minLength": 1 },
        "unexpected_truncation_detected": { "type": "boolean" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "confirmed_stopped", "timed_out", "crashed", "oom"],
      "properties": {
        "exit_code": { "type": ["integer", "null"] },
        "confirmed_stopped": { "type": "boolean" },
        "timed_out": { "type": "boolean" },
        "crashed": { "type": "boolean" },
        "oom": { "type": "boolean" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_ids", "observed_ids", "rate", "groups"],
      "properties": {
        "required_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "observed_ids": { "type": "array", "items": { "type": "string" } },
        "rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["EARLY", "MIDDLE", "LATE", "LEGACY"],
          "properties": {
            "EARLY": { "$ref": "#/$defs/groupScore" },
            "MIDDLE": { "$ref": "#/$defs/groupScore" },
            "LATE": { "$ref": "#/$defs/groupScore" },
            "LEGACY": { "$ref": "#/$defs/groupScore" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "exit_code", "assertion_ids", "passed_assertion_ids", "assertion_results", "verified_files"],
      "properties": {
        "command_id": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "assertion_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "passed_assertion_ids": { "type": "array", "items": { "type": "string" } },
        "assertion_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" },
              "detail": { "type": ["string", "null"] }
            }
          }
        },
        "verified_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prose", "matches_file_state"],
      "properties": {
        "prose": { "type": "string" },
        "matches_file_state": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_paths", "unexpected_paths"],
      "properties": {
        "changed_paths": { "type": "array", "items": { "type": "string" } },
        "unexpected_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms", "system_total_memory_bytes", "system_peak_used_memory_bytes",
        "system_minimum_available_memory_bytes", "model_server_peak_rss_bytes",
        "hermes_peak_rss_bytes", "swap_growth_bytes", "tool_call_count", "model_call_count"
      ],
      "properties": {
        "wall_time_ms": { "type": "number", "minimum": 0 },
        "system_total_memory_bytes": { "type": "integer", "minimum": 1 },
        "system_peak_used_memory_bytes": { "type": "integer", "minimum": 0 },
        "system_minimum_available_memory_bytes": { "type": "integer", "minimum": 0 },
        "model_server_peak_rss_bytes": { "type": "integer", "minimum": 0 },
        "hermes_peak_rss_bytes": { "type": "integer", "minimum": 0 },
        "swap_growth_bytes": { "type": "integer", "minimum": 0 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "model_call_count": { "type": "integer", "minimum": 0 }
      }
    },
    "restoration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "verified", "snapshot_id", "target_hashes_match"],
      "properties": {
        "attempted": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "target_hashes_match": { "type": "boolean" }
      }
    },
    "first_pass_accepted": { "type": "boolean" },
    "valid_run": { "type": "boolean" },
    "correction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["attempted", "accepted", "wall_time_ms"],
      "properties": {
        "attempted": { "type": "boolean" },
        "accepted": { "type": "boolean" },
        "wall_time_ms": { "type": "number", "minimum": 0 }
      }
    },
    "invalid_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "arm": { "const": "A" } }, "required": ["arm"] },
      "then": {
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "configured_server_tokens": { "const": 65536 },
              "observed_server_tokens": { "const": 65536 },
              "configured_hermes_tokens": { "const": 65536 },
              "observed_hermes_tokens": { "const": 65536 },
              "largest_model_input_tokens": { "type": "integer", "maximum": 57344 },
              "final_model_input_tokens": { "type": "integer", "maximum": 57344 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "arm": { "const": "B" } }, "required": ["arm"] },
      "then": {
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "configured_server_tokens": { "const": 131072 },
              "observed_server_tokens": { "const": 131072 },
              "configured_hermes_tokens": { "const": 131072 },
              "observed_hermes_tokens": { "const": 131072 },
              "largest_model_input_tokens": { "type": "integer", "minimum": 65537, "maximum": 122880 },
              "final_model_input_tokens": { "type": "integer", "maximum": 122880 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "arm": { "const": "C" } }, "required": ["arm"] },
      "then": {
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "configured_server_tokens": { "const": 262144 },
              "observed_server_tokens": { "const": 262144 },
              "configured_hermes_tokens": { "const": 262144 },
              "observed_hermes_tokens": { "const": 262144 },
              "largest_model_input_tokens": { "type": "integer", "minimum": 131073, "maximum": 253952 },
              "final_model_input_tokens": { "type": "integer", "maximum": 253952 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "groupScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "hashMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "quant", "runtime_build", "hermes_profile", "provider_id", "endpoint_identifier"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "quant": { "type": "string", "minLength": 1 },
        "runtime_build": { "type": "string", "minLength": 1 },
        "hermes_profile": { "type": "string", "minLength": 1 },
        "provider_id": { "type": "string", "minLength": 1 },
        "endpoint_identifier": { "type": "string", "minLength": 1 }
      }
    }
  }
}
