{
  "schemaVersion": "workflow-router-map.v1",
  "workflowId": "writing",
  "source": "writing.workflow.md",
  "initialStage": "drafting",
  "capabilityOwners": {
    "workflow_orchestration": "admin",
    "article_drafting": "writer",
    "independent_critique": "reviewer",
    "critique_disposition": "writer",
    "human_listen_through": "reviewer",
    "release_planning": "release-coordinator",
    "release_gate_diagnosis": "reviewer",
    "published_revision": "writer",
    "published_review": "reviewer",
    "published_apply": "release-coordinator",
    "published_verification": "reviewer",
    "published_reconciliation": "writer"
  },
  "stages": {
    "administration": {
      "role": "admin",
      "capability": "workflow_orchestration",
      "transitions": {
        "route-required": {
          "to": "drafting",
          "visualLabel": "route-required: send article request to Writer",
          "requiredReferenceKinds": ["revision", "work-request"]
        },
        "published-update-required": {
          "to": "published_revision",
          "visualLabel": "published-update-required: revise existing story",
          "requiredReferenceKinds": ["published-story", "work-request"]
        },
        "review-required": {
          "to": "review",
          "visualLabel": "review-required: recheck delegated release",
          "requiredReferenceKinds": ["revision", "review-packet", "work-request"]
        },
        "handled": {
          "to": "administration_complete",
          "visualLabel": "handled: administration complete",
          "terminal": true,
          "requiredReferenceKinds": []
        }
      }
    },
    "administration_complete": {
      "role": "admin",
      "capability": "workflow_orchestration",
      "transitions": {}
    },
    "published_revision": {
      "role": "writer",
      "capability": "published_revision",
      "transitions": {
        "review_ready": {
          "to": "published_review",
          "visualLabel": "review_ready: exact replacement and preview",
          "requiredReferenceKinds": ["revision", "published-story", "review-packet"]
        }
      }
    },
    "published_review": {
      "role": "reviewer",
      "capability": "published_review",
      "transitions": {
        "accepted": {
          "to": "published_apply",
          "visualLabel": "accepted: independently reviewed update",
          "requiredReferenceKinds": ["review", "published-story", "destination-review"]
        },
        "changes_required": {
          "to": "published_revision",
          "requiredReferenceKinds": ["findings"]
        }
      }
    },
    "published_apply": {
      "role": "release-coordinator",
      "capability": "published_apply",
      "transitions": {
        "applied": {
          "to": "published_verification",
          "visualLabel": "applied: live story changed in place",
          "requiredReferenceKinds": ["published-story", "destination-change"]
        },
        "changes_required": {
          "to": "published_revision",
          "requiredReferenceKinds": ["findings"]
        },
        "blocked": {
          "to": "administration",
          "visualLabel": "blocked: Admin inspects destination obstacle",
          "requiredReferenceKinds": ["blocker", "published-story"]
        }
      }
    },
    "published_verification": {
      "role": "reviewer",
      "capability": "published_verification",
      "transitions": {
        "verified": {
          "to": "published_reconciliation",
          "visualLabel": "verified: rendered story matches review",
          "requiredReferenceKinds": ["published-story", "destination-review"]
        },
        "changes_required": {
          "to": "published_revision",
          "requiredReferenceKinds": ["findings"]
        }
      }
    },
    "published_reconciliation": {
      "role": "writer",
      "capability": "published_reconciliation",
      "transitions": {
        "archived": {
          "to": "complete",
          "visualLabel": "archived: archive and mirror reconciled",
          "terminal": true,
          "requiredReferenceKinds": ["archive-record", "published-story"]
        }
      }
    },
    "drafting": {
      "role": "writer",
      "capability": "article_drafting",
      "transitions": {
        "review_ready": {
          "to": "review",
          "requiredReferenceKinds": ["revision", "review-packet"]
        }
      }
    },
    "review": {
      "role": "reviewer",
      "capability": "independent_critique",
      "transitions": {
        "source_accepted": {
          "to": "source_complete",
          "visualLabel": "source_accepted: source-only review complete",
          "terminal": true,
          "requiredReferenceKinds": ["review"]
        },
        "accepted": {
          "to": "release",
          "visualLabel": "accepted: review passes policy",
          "requiredReferenceKinds": ["review", "destination-review"],
          "retryPolicy": {
            "requireChangedProgress": true,
            "progressReferenceKinds": ["review"]
          }
        },
        "changes_required": {
          "to": "correction",
          "requiredReferenceKinds": ["findings"]
        },
        "admin_decision_required": {
          "to": "admin_release_review",
          "visualLabel": "admin_decision_required: exact delegated verdict",
          "requiredReferenceKinds": ["review", "destination-review", "work-request"]
        },
        "human_action_required": {
          "to": "human_review",
          "visualLabel": "human_action_required: listen or acceptance pending",
          "waitForHuman": true,
          "requiredReferenceKinds": ["human-action"]
        }
      }
    },
    "source_complete": {
      "role": "reviewer",
      "capability": "independent_critique",
      "transitions": {}
    },
    "admin_release_review": {
      "role": "admin",
      "capability": "workflow_orchestration",
      "transitions": {
        "approved": {
          "to": "release",
          "visualLabel": "approved: Admin-delegated release decision",
          "requiredReferenceKinds": ["review", "destination-review", "release-delegation"]
        },
        "changes_required": {
          "to": "correction",
          "requiredReferenceKinds": ["findings"]
        },
        "decision_missing": {
          "to": "human_review",
          "visualLabel": "decision_missing: wait for author",
          "waitForHuman": true,
          "requiredReferenceKinds": ["human-action"]
        }
      }
    },
    "human_review": {
      "role": "reviewer",
      "capability": "human_listen_through",
      "transitions": {
        "listen_pending": {
          "to": "human_review",
          "visualLabel": "listen_pending: wait for confirmation",
          "waitForHuman": true,
          "requiredReferenceKinds": ["human-action"]
        },
        "changes_required": {
          "to": "correction",
          "visualLabel": "changes_required: stale cross-surface evidence",
          "requiredReferenceKinds": ["findings"]
        },
        "human_listened": {
          "to": "release",
          "visualLabel": "human_listened: review passed",
          "requiredReferenceKinds": ["review", "destination-review", "human-listen"]
        },
        "admin_delegated": {
          "to": "release",
          "visualLabel": "admin_delegated: explicit human mandate reviewed",
          "requiredReferenceKinds": ["review", "destination-review", "release-delegation"]
        },
        "test_listen_simulated": {
          "to": "release",
          "visualLabel": "test_listen_simulated: test release only",
          "requiredReferenceKinds": ["review", "destination-review", "test-listen-simulation"]
        },
        "human_accepted": {
          "to": "release",
          "requiredReferenceKinds": ["human-acceptance", "destination-review"]
        },
        "human_rejected": {
          "to": "correction",
          "requiredReferenceKinds": ["findings"]
        }
      }
    },
    "correction": {
      "role": "writer",
      "capability": "critique_disposition",
      "transitions": {
        "review_ready": {
          "to": "review",
          "visualLabel": "review_ready: article or draft evidence changed",
          "requiredReferenceKinds": ["revision", "review-packet"],
          "retryPolicy": {
            "requireChangedProgress": true,
            "progressReferenceKinds": ["revision", "review-packet"]
          }
        }
      }
    },
    "release": {
      "role": "release-coordinator",
      "capability": "release_planning",
      "transitions": {
        "released": {
          "to": "archive_update",
          "visualLabel": "released: schedule verified; archive status",
          "requiredReferenceKinds": ["release-record"]
        },
        "review_required": {
          "to": "diagnosis",
          "visualLabel": "review_required: missing release evidence",
          "requiredReferenceKinds": ["blocker"],
          "retryPolicy": {
            "requireChangedProgress": true,
            "progressReferenceKinds": ["blocker"]
          }
        }
      }
    },
    "archive_update": {
      "role": "writer",
      "capability": "article_drafting",
      "transitions": {
        "archived": {
          "to": "complete",
          "visualLabel": "archived: release record verified",
          "terminal": true,
          "requiredReferenceKinds": ["archive-record"]
        }
      }
    },
    "diagnosis": {
      "role": "reviewer",
      "capability": "release_gate_diagnosis",
      "transitions": {
        "review_ready": {
          "to": "review",
          "visualLabel": "review_ready: prepared packet",
          "requiredReferenceKinds": ["revision", "review-packet"]
        },
        "changes_required": {
          "to": "correction",
          "visualLabel": "changes_required: Writer preparation",
          "requiredReferenceKinds": ["findings"]
        },
        "proven": {
          "to": "release",
          "visualLabel": "proven: new release-gate proof",
          "requiredReferenceKinds": ["review", "destination-review", "release-gate"],
          "retryPolicy": {
            "requireChangedProgress": true,
            "progressReferenceKinds": ["review", "release-gate"]
          }
        }
      }
    },
    "complete": {
      "role": "writer",
      "capability": "article_drafting",
      "transitions": {}
    }
  }
}
